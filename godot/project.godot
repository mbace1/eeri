; Eeri — Godot port
; Structure follows EERI_GODOT_HANDOFF.md §4.
; Canon: PHASING.md > DESIGN.md > ART_BRIEF.md / ART_TARGET.md > assets/README.md + manifest.json > VERSIONS.md

config_version=5

[application]

config/name="Eeri"
config/description="On-foot Mario 3 / Yoshi's Crafted World platformer on a Tonka x Cat worksite. Godot skeleton — no gameplay ported yet, see EERI_GODOT_HANDOFF.md."
run/main_scene="res://scenes/play.tscn"
config/features=PackedStringArray("4.3")

[autoload]

AssetRegistry="*res://autoload/asset_registry.gd"
GameState="*res://autoload/game_state.gd"
Loc="*res://autoload/loc.gd"
Audio="*res://autoload/audio.gd"

[internationalization]

; GENERATED from js/lang.js by tools/export-locale.mjs — see autoload/loc.gd.
; English is the per-KEY fallback (DESIGN §4.4), which is the house rule and
; also completely silent, which is why the exporter refuses to write a pack
; with a missing key rather than letting the fallback paper over it.
locale/translations=PackedStringArray("res://locale/ui.en.translation", "res://locale/ui.fi.translation", "res://locale/ui.ja.translation")
locale/fallback="en"

[display]

; Mobile-first, controller-first (PHASING.md §4: "no mouse/keyboard language
; anywhere"). canvas_items + expand keeps one world camera across phone
; portrait, phone landscape and desktop, same as the browser build.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; Browsers have no Vulkan, so state it for the web target explicitly too
; rather than relying on inheritance -- toko-drop-godot (same engine, same
; hub, same export path) carries the same line.
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
; SHADOW ATLAS SIZE, added 2026-08-26 chasing the black-screen-on-Android
; report -- and the strongest evidence yet, because it comes from a build
; that WORKS on the same owner's phone rather than from reasoning.
;
; The symptom: the 2D CanvasLayer (HUD, touch plate) draws fine while the
; ENTIRE 3D pass produces nothing -- not even the sky-blue clear colour
; play.gd's Environment sets, which is why the report is "black" and not
; "empty room". A whole 3D pass failing while 2D survives points at a
; resource the 3D pass allocates and 2D does not.
;
; Godot's default directional shadow atlas is 4096x4096. This project left
; it at that default while running a shadow-casting DirectionalLight3D
; (play.gd's "Key"). toko-drop-godot renders 3D correctly on this owner's
; phone and explicitly does NOT: its PORT_STATUS.md records the cut
; ("the directional shadow atlas 4096 -> 2048") and its project.godot
; carries a further .mobile=1024. Same engine, same web export, same hub,
; same device -- the difference is here.
;
; 2048 (1024 on mobile) matches the sibling exactly. Eeri's key light is
; one soft directional over a fixed side-on camera, which is the same shape
; of scene that made the cut free there. Do not raise these without
; re-testing on a real phone; GODOT_PORT_ANALYSIS.md SS3.1 wants the soft
; light and contact shadows kept, so the atlas is made smaller rather than
; the feature turned off.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024

[importer_defaults]

; THE SINGLE BIGGEST LEVER ON DOWNLOAD SIZE, measured 2026-08-24.
; Godot's default texture import is LOSSLESS. Every layer in assets/2d is
; already lossy WebP (the browser build ships all four worlds in 7.6MB), so
; the default decoded them and re-encoded them lossless: a 35.7MB pack that
; gzip could not touch (35.4MB), for art that is 7.6MB at source.
; Mode 1 = Lossy keeps them as lossy WebP inside the .ctex.
; Re-measure before changing this; see GODOT_PORT_ANALYSIS.md §4.
texture={
"compress/mode": 2,
"compress/lossy_quality": 0.9,
"process/size_limit": 2048
}
; VRAM COMPRESSION -- owner's call, 2026-08-27 ("VRAM"). Texture memory drops
; 152.1MB -> 22.5MB, nearly 7x, which is the whole point: it is the leading
; suspect in the black-screen-on-Android report and the one large difference
; between this project and toko-drop-godot, which renders 3D fine on that
; same phone and ships no textures at all.
;
; EVERY ROW BELOW WAS EXPORTED AND MEASURED, not estimated:
;
;                        resolution   wire    pck raw   texture VRAM
;   mode 1 lossy @4096      4096      24.7MB     18MB      152.1MB  (original)
;   mode 1 lossy @2048      2048      ~24MB    14.3MB       55.6MB  (v16)
;   mode 2 VRAM  @4096      4096      45.0MB   204.4MB      45.3MB  <- CANNOT SHIP
;   mode 2 VRAM  @3072      3072      38.3MB   129.5MB        --    <- CANNOT SHIP
;   mode 2 VRAM  @2560      2560      35.0MB   100.0MB        --    <- CANNOT SHIP
;   mode 2 VRAM  @2048 <--  2048      32.0MB    75.9MB       22.5MB (this)
;
; WHY 4096 IS NOT AN OPTION, and it is a hard external limit rather than a
; judgement call: GITHUB REFUSES ANY FILE OVER 100MB. The 4096 pack is 204MB
; and the push is rejected outright by a pre-receive hook --
;   "File eeri-godot/index.pck is 204.39 MB; this exceeds GitHub's file size
;    limit of 100.00 MB"
; 3072 (129MB) and even 2560 (exactly 100.0MB) are refused too. 2048 fits with
; 23MB of headroom. The hub is served from GitHub Pages, so this ceiling
; governs every future texture decision here -- check a pack against it BEFORE
; planning around a resolution.
;
; The pack doubles because BOTH format families ship, which was verified
; rather than assumed: desktop Chrome reports only
; WEBGL_compressed_texture_s3tc, phones only ETC2. A single-format pack is a
; black texture on half the machines that open the hub.
;
; If 4096 is ever wanted again, the routes are: Git LFS (Pages support is
; poor), hosting the pack off-repo, or splitting per-world packs loaded on
; demand -- all real work, none of them a setting.
;
; MIPMAPS OFF: they cost another 60MB of pack to fix shimmer nobody has
; reported, on lanes that are mostly magnified rather than minified.

[input]

; Controller-first (DESIGN.md §5). Every action is reachable from a pad, a
; keyboard and (later) a touch button, and nothing in the UI is ever allowed
; to NAME a key or a mouse — §6.4, "no key caps or mouse icons, ever".
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194319,"physical_keycode":0,"pressed":true)
, Object(InputEventKey,"keycode":65,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":13,"pressed":true)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194321,"physical_keycode":0,"pressed":true)
, Object(InputEventKey,"keycode":68,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":14,"pressed":true)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)
]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194320,"physical_keycode":0,"pressed":true)
, Object(InputEventKey,"keycode":87,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":11,"pressed":true)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194322,"physical_keycode":0,"pressed":true)
, Object(InputEventKey,"keycode":83,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":12,"pressed":true)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)
]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":0,"pressed":true)
]
}
action={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":4194309,"physical_keycode":0,"pressed":true)
, Object(InputEventJoypadButton,"button_index":2,"pressed":true)
]
}
