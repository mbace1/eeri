# The Godot editor cache and import artefacts — regenerated on first open,
# and machine/version specific.
/godot/.godot/

# The canon copy for res:// — regenerated by godot/tools/sync-data.mjs.
# Two committed copies of the manifest + art is how a second lineage starts.
/godot/data/

# Generated from js/lang.js by godot/tools/export-locale.mjs. Same rule as
# data/: the source of truth is js/lang.js, and a second committed copy of
# the Finnish is what drifts.
/godot/locale/

# The web export build — a build artefact that would put the thing this repo
# was split out of Suds-Jack to avoid straight back into it. It deploys to
# Suds-Jack's gh-pages as a sibling folder, same as the browser build does.
/build/
/eeri-godot/

# Node's own noise, if a tool ever needs it. There is no build step for the
# browser game and none is planned for the Godot tooling either.
node_modules/

# Screenshot harness output — artefacts, regenerated by tools/shot.tscn.
/godot/tools/_shot*.png
/godot/tools/_shot*.png.import
